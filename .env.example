# --- Security ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# --- Local ASR (faster-whisper) ---
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Local LLM (GGUF for llama.cpp) ---
# Put your GGUF file into ./models or upload it in Admin -> Models.
# If you manage models via the Admin registry, LLM_GGUF can stay empty.
LLM_GGUF=
# Optional (env fallback): semicolon-separated absolute paths inside container.
# If set, the UI can choose a model per request.
LLM_MODEL_PATHS=
LLM_DEFAULT_MODEL=
LLM_CTX=4096
LLM_THREADS=4
LLM_GPU_LAYERS=0

# --- Local TTS (Piper) ---
# Put piper binary in ./piper/piper and models in ./models
PIPER_ONNX=swahili_piper.onnx
PIPER_JSON=swahili_piper.json

# --- Training / Versioned artefacts (local) ---
REDIS_URL=redis://localhost:6379/0
TRAINED_ROOT=/models/trained
TRAIN_OUTPUT_DIR=/models/trained

# Optional: use local LLM to rewrite translations after glossary mapping
TRANSLATE_USE_LLM=0

# External model microservice
MODEL_SERVICE_URL=http://model_service:8010

# Hugging Face GGUF model used by services/model_service.
# Example for Qwen2.5 0.5B Instruct quantized GGUF:
HF_MODEL_ID=qwen2.5-0.5b-instruct-q4_k_m
HF_MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF
HF_MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
# Set only for private/gated repositories.
HF_TOKEN=

LLM_MAX_TOKENS=256

# Browser-visible API URLs.
# Local Docker without Nginx:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# Online behind the provided Nginx config, use:
# NEXT_PUBLIC_API_BASE_URL=/api
# NEXT_PUBLIC_MEDIA_BASE_URL=/media

WITH_LORA=0
TRAIN_STRATEGY=stub
LORA_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LORA_MAX_STEPS=200
LORA_LR=0.0002
