# --- Security ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# --- Local ASR (faster-whisper) ---
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Local LLM (GGUF for llama.cpp) ---
# Put your GGUF file into ./models then set the filename here.
LLM_GGUF=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
LLM_MODEL_PATH=./models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
LLM_CTX=4096
LLM_THREADS=4
LLM_GPU_LAYERS=0

# --- Local TTS (Piper) ---
# Put piper binary in ./piper/piper and models in ./models
PIPER_ONNX=./models/sw_CD-lanfrica-medium.onnx
PIPER_JSON=./models/sw_CD-lanfrica-medium.onnx.json
PIPER_BIN=./piper/piper

# --- Training / Versioned artefacts (local) ---
REDIS_URL=redis://localhost:6379/0 #pour Docker Compose
#REDIS_URL = localhost:6379/0
TRAINED_ROOT=./models/trained
TRAIN_OUTPUT_DIR=./models/trained

# Optional: use local LLM to rewrite translations after glossary mapping
TRANSLATE_USE_LLM=0
